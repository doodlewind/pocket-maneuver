; The interface: screen pixels through an orthographic matrix.
.fvec projection[4]
.constf consts(1.0, 0.0039215686, 0.0, 0.0)
.in inpos v0
.in intex v1
.in inclr v2
.out outpos position
.out outtex texcoord0
.out outclr color
.entry main
.proc main
    mov r0.xyz, inpos.xyz
    mov r0.w, consts.x
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mov r1.xy, intex.xy
    mov r1.z, consts.z
    mov r1.w, consts.x
    mov outtex, r1
    mul outclr, consts.yyyy, inclr
    end
.end
