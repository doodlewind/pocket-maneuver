; Skinned models: the player and the giants. Two bones per vertex; `bones`
; holds three rows per bone, taking a bind-pose position to world space.
; Lighting is the scene's sun and hemisphere per vertex. The tint is sRGB, so
; the light is encoded before it multiplies; the square root stands in for
; the 1 / 2.2 power.
.fvec projection[4]
.fvec bones[57]
; sun direction and visibility; sun; sky; bounce.
.fvec light[4]
.constf consts(1.0, 3.0, 0.0039215686, 0.5)
.constf more(0.92, 0.0, 0.00001, 0.007874016)
.in inpos v0
.in innrm v1
.in inclr v2
; bone 0, bone 1, weight 0, weight 1
.in inbw v3
.out outpos position
.out outclr color
.entry main
.proc main
    mov r0.xyz, inpos.xyz
    mov r0.w, consts.x
    mul r10.xyz, more.www, innrm.xyz
    mul r1.xy, consts.yy, inbw.xy
    mul r1.zw, consts.zz, inbw.zw

    mova a0.x, r1.x
    dp4 r2.x, bones[a0.x], r0
    dp4 r2.y, bones[a0.x+1], r0
    dp4 r2.z, bones[a0.x+2], r0
    dp3 r3.x, bones[a0.x], r10
    dp3 r3.y, bones[a0.x+1], r10
    dp3 r3.z, bones[a0.x+2], r10

    mova a0.x, r1.y
    dp4 r4.x, bones[a0.x], r0
    dp4 r4.y, bones[a0.x+1], r0
    dp4 r4.z, bones[a0.x+2], r0
    dp3 r5.x, bones[a0.x], r10
    dp3 r5.y, bones[a0.x+1], r10
    dp3 r5.z, bones[a0.x+2], r10

    mul r2.xyz, r1.zzz, r2.xyz
    mul r4.xyz, r1.www, r4.xyz
    add r2.xyz, r2.xyz, r4.xyz
    mov r2.w, consts.x
    dp4 outpos.x, projection[0], r2
    dp4 outpos.y, projection[1], r2
    dp4 outpos.z, projection[2], r2
    dp4 outpos.w, projection[3], r2

    mul r3.xyz, r1.zzz, r3.xyz
    mul r5.xyz, r1.www, r5.xyz
    add r3.xyz, r3.xyz, r5.xyz
    dp3 r6.x, r3, r3
    max r6.x, more.z, r6.x
    rsq r6.x, r6.x
    mul r3.xyz, r3.xyz, r6.xxx

    ; ndl = max(n . sun, 0) * visibility; up = 0.5 + 0.5 * n.y
    dp3 r6.x, light[0], r3
    max r6.x, more.y, r6.x
    mul r6.x, light[0].w, r6.x
    mul r6.y, consts.w, r3.y
    add r6.y, consts.w, r6.y
    ; hemisphere = bounce + (sky - bounce) * up
    mov r7.xyz, light[3].xyz
    mov r8.xyz, light[2].xyz
    add r8.xyz, r8.xyz, -r7.xyz
    mul r8.xyz, r6.yyy, r8.xyz
    add r7.xyz, r7.xyz, r8.xyz
    mul r7.xyz, more.xxx, r7.xyz
    mov r8.xyz, light[1].xyz
    mul r8.xyz, r6.xxx, r8.xyz
    add r7.xyz, r7.xyz, r8.xyz
    ; sqrt(x) = x * rsq(x)
    max r7.xyz, more.zzz, r7.xyz
    rsq r8.x, r7.x
    rsq r8.y, r7.y
    rsq r8.z, r7.z
    mul r7.xyz, r7.xyz, r8.xyz

    mul r9.xyz, consts.zzz, inclr.xyz
    mul r9.xyz, r9.xyz, r7.xyz
    mov r9.w, consts.x
    mov outclr, r9
    end
.end
