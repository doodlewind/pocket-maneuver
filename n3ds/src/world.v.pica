; The static world. Positions are on one grid for the whole world, so a frame
; sets one matrix and one scale. Every mapped output component is written once.
.fvec projection[4]
; x: metres per position unit, y: 1 / 255, z and w: texture coordinate scales.
.fvec scale
.constf ones(1.0, 1.0, 1.0, 1.0)
.constf zeros(0.0, 0.0, 0.0, 0.0)
.in inpos v0
.in intex v1
.in inclr v2
.out outpos position
.out outtex texcoord0
.out outclr color
.entry main
.proc main
    mul r0.xyz, scale.xxx, inpos.xyz
    mov r0.w, ones.w
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul r1.xy, scale.zw, intex.xy
    mov r1.z, zeros.z
    mov r1.w, ones.w
    mov outtex, r1
    mul r2.xyz, scale.yyy, inclr.xyz
    mov r2.w, ones.w
    mov outclr, r2
    end
.end
